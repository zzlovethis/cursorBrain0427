/* WYSIWYG编辑模式样式 */
.wysiwyg-container {
  position: fixed;
  top: 30rpx; /* Match the carousel-panel top position */
  left: 50%;
  transform: translateX(-50%);
  width: 90%; /* Match the carousel-panel width */
  height: auto; /* Let height be determined by top and bottom positions */
  max-height: 90vh; /* Same max-height as carousel-panel */
  background-color: #1a3a5a; /* Match the carousel-panel background */
  border-radius: 30rpx; /* Match the carousel-panel border-radius */
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.3); /* Match the carousel-panel shadow */
  display: flex;
  flex-direction: column;
  overflow: hidden;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
  bottom: 105rpx; /* Match the carousel-panel bottom position */
  margin: 0; /* Reset all margins */
}

.wysiwyg-container.visible {
  opacity: 1;
  visibility: visible;
}

.wysiwyg-header {
  width: 100%;
  height: 80rpx;
  background-color: rgba(20, 40, 70, 0.9);
