}

/* 悬浮编辑工具按钮 */
.editor-floating-button {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(60, 120, 220, 0.8);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 101;
  transition: all 0.3s;
}

.editor-button-icon {
  color: white;
  font-size: 50rpx;
  font-weight: bold;
}

.editor-floating-button:active {
  transform: scale(0.95);
  background-color: rgba(70, 140, 255, 0.9);
}

/* 媒体选项弹出菜单遮罩层 */
.media-options-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 102;
}

/* 级联式菜单样式 */
.cascading-menu {
  position: absolute;
  bottom: 120rpx;
  right: 30rpx;
  background-color: #1a3a5a;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 15rpx;
  box-shadow: 0 5rpx 20rpx rgba(0, 0, 0, 0.2);
  width: 580rpx;
  max-height: 80vh;
  overflow-y: auto;
  z-index: 103;
  opacity: 0;
  visibility: hidden;
  transform: translateY(20px) scale(0.95);
  transition: all 0.3s;
}

.cascading-menu.visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
}

.menu-group {
  margin-bottom: 10rpx;
}

.menu-group-title {
  padding: 15rpx 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  background-color: rgba(0, 0, 0, 0.2);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.menu-items {
  display: flex;
  flex-wrap: wrap;
  padding: 10rpx;
}

.menu-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 15rpx 10rpx;
  transition: all 0.2s;
}

.menu-item:active {
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
}

.menu-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
  color: white;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.menu-item text {
  font-size: 22rpx;
  color: white;
  text-align: center;
}