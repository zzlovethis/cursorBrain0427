/* detail.wxss */
page {
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.detail-container {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  padding-bottom: 150rpx;
}

/* Header styles */
.detail-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  height: 80rpx;
}

.back-button {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.back-icon {
  font-size: 36rpx;
  font-weight: bold;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  margin: 0 30rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.header-actions {
  display: flex;
  align-items: center;
}

.action-more {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
}

/* Content section styles */
.detail-content {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.content-header {
  display: flex;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.detail-cover {
  width: 240rpx;
  height: 320rpx;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.detail-info {
  flex: 1;
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.detail-author, .detail-category, .detail-date {
  color: #666;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.content-body {
  padding: 30rpx;
}

.content-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
  display: block;
}

.content-text {
  line-height: 1.8;
  color: #444;
  font-size: 28rpx;
  text-align: justify;
}

.chapter-list {
  margin-top: 20rpx;
}

.chapter-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.chapter-title {
  font-size: 30rpx;
  margin-bottom: 8rpx;
  display: block;
}

.chapter-info {
  font-size: 24rpx;
  color: #999;
}

.related-list {
  white-space: nowrap;
  margin: 20rpx 0 0;
}

.related-item {
  display: inline-block;
  width: 200rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.related-cover {
  width: 200rpx;
  height: 280rpx;
  border-radius: 8rpx;
}

.related-title {
  display: block;
  width: 100%;
  font-size: 26rpx;
  margin-top: 10rpx;
  white-space: normal;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* Comments section styles */
.comments-section {
  margin: 20rpx;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.write-comment {
  color: #1a3a5a;
  font-size: 28rpx;
}

.comment-list {
  margin-top: 30rpx;
}

.comment-item {
  display: flex;
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.comment-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.comment-username {
  font-size: 28rpx;
  font-weight: 500;
}

.comment-time {
  font-size: 24rpx;
  color: #999;
}

.comment-text {
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.comment-actions {
  display: flex;
  margin-top: 10rpx;
}

.comment-action {
  display: flex;
  align-items: center;
  margin-right: 30rpx;
  font-size: 24rpx;
  color: #666;
}

.action-icon {
  margin-right: 6rpx;
}

.action-icon.liked {
  color: #ff4d4f;
}

.no-comments {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
}

/* Comment input styles */
.comment-input-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
}

.comment-input-container.visible {
  transform: translateY(0);
}

.comment-input-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.close-comment {
  font-size: 40rpx;
  line-height: 1;
}

.comment-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.comment-input-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.character-count {
  color: #999;
  font-size: 24rpx;
}

.submit-comment {
  background-color: #1a3a5a;
  color: #fff;
  font-size: 28rpx;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  margin: 0;
}

/* Overlay styles */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 90;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.overlay.visible {
  opacity: 1;
  visibility: visible;
} 