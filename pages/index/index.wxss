/* 主容器 */
.main-container {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5; /* 保持原有背景色 */
}

/* 主轮播图样式 */
.main-swiper {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

/* 轮播页面通用样式 */
.swiper-page {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  padding: 40rpx;
  box-sizing: border-box;
  border: 4rpx solid white;
  border-radius: 30rpx;
  background-color: #1a3a5a; /* 深蓝色背景 */
}

/* 标题和装饰图标容器 */
.header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 15rpx 0;
  margin-top: 30rpx;
  margin-bottom: 30rpx; /* 增加与正文的间距 */
}

.title {
  font-size: 50rpx; /* 将原来的42rpx增加到50rpx */
  font-weight: 400;
  letter-spacing: 4rpx;
  color: white;
}

/* 心窗标题特殊样式 */
.announcement-page .header .title {
  font-size: 60rpx; /* 特别增大心窗的字号 */
  text-shadow: 0 0 10rpx rgba(120, 220, 255, 0.8),
               0 0 20rpx rgba(100, 200, 255, 0.6),
               0 0 30rpx rgba(80, 180, 255, 0.4);
}

/* 南极光文字特效 - 增强版 */
@keyframes auroraText {
  0% {
    text-shadow: 0 0 10rpx rgba(120, 220, 255, 0.8),
                 0 0 20rpx rgba(100, 200, 255, 0.6),
                 0 0 30rpx rgba(80, 180, 255, 0.4),
                 0 0 40rpx rgba(60, 160, 255, 0.2);
    color: rgb(220, 240, 255);
  }
  25% {
    text-shadow: 0 0 10rpx rgba(120, 255, 180, 0.8),
                 0 0 20rpx rgba(100, 255, 160, 0.6),
                 0 0 30rpx rgba(80, 255, 140, 0.4),
                 0 0 40rpx rgba(60, 255, 120, 0.2);
    color: rgb(220, 255, 240);
  }
  50% {
    text-shadow: 0 0 10rpx rgba(180, 120, 255, 0.8),
                 0 0 20rpx rgba(160, 100, 255, 0.6),
                 0 0 30rpx rgba(140, 80, 255, 0.4),
                 0 0 40rpx rgba(120, 60, 255, 0.2);
    color: rgb(230, 220, 255);
  }
  75% {
    text-shadow: 0 0 10rpx rgba(255, 120, 180, 0.8),
                 0 0 20rpx rgba(255, 100, 160, 0.6),
                 0 0 30rpx rgba(255, 80, 140, 0.4),
                 0 0 40rpx rgba(255, 60, 120, 0.2);
    color: rgb(255, 220, 240);
  }
  100% {
    text-shadow: 0 0 10rpx rgba(120, 220, 255, 0.8),
                 0 0 20rpx rgba(100, 200, 255, 0.6),
                 0 0 30rpx rgba(80, 180, 255, 0.4),
                 0 0 40rpx rgba(60, 160, 255, 0.2);
    color: rgb(220, 240, 255);
  }
}

/* 应用南极光特效到正文 */
.quote-content .title {
  animation: auroraText 8s infinite linear;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
  font-weight: 400;
}

