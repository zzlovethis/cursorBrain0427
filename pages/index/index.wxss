/* 删除原来基于nth-child的样式 */
.grid-item:nth-child(1) .grid-item-icon:before,
.grid-item:nth-child(2) .grid-item-icon:before,
.grid-item:nth-child(3) .grid-item-icon:before,
.grid-item:nth-child(4) .grid-item-icon:before,
.grid-item:nth-child(5) .grid-item-icon:before,
.grid-item:nth-child(6) .grid-item-icon:before,
.grid-item:nth-child(7) .grid-item-icon:before,
.grid-item:nth-child(8) .grid-item-icon:before,
.grid-item:nth-child(9) .grid-item-icon:before,
.grid-item:nth-child(10) .grid-item-icon:before,
.grid-item:nth-child(11) .grid-item-icon:before,
.grid-item:nth-child(12) .grid-item-icon:before {
  /* 这些选择器将被我们上面的新选择器替代 */
  background-image: none;
}

