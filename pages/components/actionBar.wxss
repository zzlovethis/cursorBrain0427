/* actionBar.wxss */
.action-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  width: 100%;
  height: 90rpx;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-top: 20rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.action-bar.floating {
  position: fixed;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
  width: calc(100% - 60rpx);
  z-index: 100;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  flex: 1;
  position: relative;
  transition: all 0.3s;
}

.action-item.active {
  color: #1a3a5a;
  font-weight: 500;
}

.action-item text {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}

.action-item.active text {
  color: #1a3a5a;
}

/* Icons */
.icon-view, .icon-like, .icon-bookmark, .icon-share {
  width: 40rpx;
  height: 40rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

