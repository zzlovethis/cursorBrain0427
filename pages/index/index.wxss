  margin-bottom: 20rpx;
}

.audio-button {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
}

.audio-icon {
  color: white;
  font-size: 30rpx;
}

.audio-progress {
  flex: 1;
  margin: 0 10rpx;
}

.audio-time {
  color: white;
  font-size: 24rpx;
  margin-left: 10rpx;
}

/* 同声文字流动屏 */
.transcript-container {
  margin-top: 20rpx;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  padding: 15rpx;
  height: 70rpx;
  overflow: hidden;
  position: relative;
}

.transcript-scroll {
  white-space: nowrap;
  transition: transform 0.5s linear;
}

.transcript-text {
  color: white;
  font-size: 26rpx;
}

/* 调整内容盒子样式，使其可以容纳媒体内容 */
.content-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  margin: 40rpx 0;
  position: relative;
}

/* 中央控制区域 */
.center-control-area {
  position: absolute;
  bottom: 15rpx; /* 调整为15rpx，确保与悬浮窗底部有适当间距 */
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  z-index: 10;
}

/* 底部编辑按钮 - 立体感和北极流光特效 */
.bottom-edit-btn {
  width: 100rpx;
  height: 54rpx;
  background: linear-gradient(135deg, rgba(60, 120, 200, 0.6) 0%, rgba(30, 80, 180, 0.7) 50%, rgba(20, 50, 130, 0.8) 100%);
  border-radius: 27rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 auto 20rpx;
  color: white;
  font-size: 28rpx;
  font-weight: 500;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
  box-shadow: 
    0 3rpx 10rpx rgba(0, 0, 0, 0.3),
    0 0 15rpx rgba(100, 200, 255, 0.3),
    inset 2rpx 2rpx 5rpx rgba(255, 255, 255, 0.5),
    inset -2rpx -2rpx 5rpx rgba(0, 0, 100, 0.3);
  border: 1rpx solid rgba(100, 180, 255, 0.5);
  padding: 0 10rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 1rpx;
  position: relative;
  overflow: hidden;
  z-index: 1;
}

/* 添加流光效果 */
.bottom-edit-btn::before {
  content: '';
  position: absolute;
  top: -100%;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    135deg, 
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0) 40%,
    rgba(255, 255, 255, 0.4) 50%,
    rgba(255, 255, 255, 0) 60%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: rotate(45deg);
  animation: northernLightFlow 3s infinite linear;
  z-index: -1;
}

/* 北极光流动动画 */
@keyframes northernLightFlow {
  0% {
    top: -100%;
    left: -100%;
  }
  100% {
    top: 100%;
    left: 100%;
  }
}

.bottom-edit-btn:active {
  background: linear-gradient(135deg, rgba(50, 110, 190, 0.7) 0%, rgba(20, 70, 170, 0.8) 50%, rgba(10, 40, 120, 0.9) 100%);
  box-shadow: 
    0 1rpx 5rpx rgba(0, 0, 0, 0.4),
    0 0 10rpx rgba(100, 200, 255, 0.2),
    inset 1rpx 1rpx 3rpx rgba(255, 255, 255, 0.4),
    inset -1rpx -1rpx 3rpx rgba(0, 0, 100, 0.4);
  transform: translateY(1rpx) scale(0.98);
}

/* 压缩的底部编辑按钮 */
.compact-btn {
  width: 100rpx;
  height: 54rpx;
  line-height: 54rpx;
  font-size: 28rpx;
  border-radius: 27rpx;
  padding: 0 10rpx;
}

/* 底部编辑按钮特有样式 - 增强立体感和特效 */
.announcement-page .bottom-edit-btn {
  background: linear-gradient(135deg, rgba(70, 130, 210, 0.7) 0%, rgba(40, 90, 190, 0.8) 50%, rgba(20, 60, 140, 0.7) 100%);
  box-shadow: 
    0 3rpx 10rpx rgba(0, 0, 0, 0.3),
    0 0 15rpx rgba(120, 210, 255, 0.4),
    inset 2rpx 2rpx 5rpx rgba(255, 255, 255, 0.6),
    inset -2rpx -2rpx 5rpx rgba(0, 0, 100, 0.4);
  font-size: 28rpx;
  font-weight: 500;
  height: 54rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(120, 200, 255, 0.6);
}

/* 指示点区域样式 */
.indicator-dots {
  display: flex;
  justify-content: center;
  margin-top: 15rpx;
  width: 100%;
}

/* 自定义指示点样式 */
.custom-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  margin: 0 10rpx;
  transition: all 0.2s ease;
}

.custom-dot.active {
  background-color: rgba(255, 255, 255, 1);
  width: 20rpx;
  height: 20rpx;
}

/* 覆盖原始swiper指示点样式，使其在我们的自定义区域中显示 */
.swiper-page .wx-swiper-dots {
  position: static !important;
  margin-bottom: 0 !important;
}

/* 网格菜单弹窗 */
.grid-menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 1005;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s;
}

.grid-menu-overlay.visible {
  visibility: visible;
  opacity: 1;
}

.grid-menu {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  width: 85%;
  background-color: white;
  border-radius: 20rpx;
  overflow: hidden;
  z-index: 1010;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s;
}

.grid-menu.visible {
  visibility: visible;
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

.grid-menu-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.grid-menu-header text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.close-grid-menu {
  font-size: 40rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.grid-menu-content {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
}

.grid-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}

.grid-item:active {
  background-color: #f5f5f5;
}

.grid-item-icon {
  width: 80rpx;
  height: 80rpx;
  background-color: #f2f2f2;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 10rpx;
  position: relative;
}

