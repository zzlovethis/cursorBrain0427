/* Animation */
.action-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%) scale(0);
  width: 20rpx;
  height: 6rpx;
  background-color: #1a3a5a;
  border-radius: 3rpx;
  transition: transform 0.3s;
}

.action-item.active::after {
  transform: translateX(-50%) scale(1);
}

.action-item:active {
  transform: scale(0.95);
} 