/* 可拖拽的悬浮按钮 */
.floating-button {
  position: fixed;
  width: 85rpx; /* 适当减小尺寸，避免过大影响界面 */
  height: 85rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(20, 80, 160, 0.5) 0%, rgba(30, 100, 200, 0.6) 50%, rgba(20, 80, 160, 0.5) 100%);
  backdrop-filter: blur(2px);
  box-shadow: 
    0 3rpx 10rpx rgba(0, 0, 0, 0.2),
    inset 2rpx 2rpx 10rpx rgba(255, 255, 255, 0.5),
    inset -2rpx -2rpx 10rpx rgba(0, 0, 40, 0.3);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: transform, top, left;
  touch-action: none;
  border: 1px solid rgba(255, 255, 255, 0.5);
  overflow: hidden;
  opacity: 0.9; /* 稍微降低不透明度，让其不那么突兀 */
}

/* 流光效果 */
.floating-button::before {
  content: "";
  position: absolute;
  top: -100%;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    135deg, 
    transparent 0%,
    rgba(255, 255, 255, 0) 30%,
    rgba(255, 255, 255, 0.3) 50%,
    rgba(255, 255, 255, 0) 70%,
    transparent 100%
  );
  transform: rotate(45deg);
  animation: flowLight 4s linear infinite;
}

@keyframes flowLight {
  0% {
    top: -100%;
    left: -100%;
  }
  25% {
    top: -50%;
    left: 0%;
  }
  50% {
    top: 0%;
    left: 50%;
  }
  75% {
    top: 50%;
    left: 100%;
  }
  100% {
    top: 100%;
    left: 150%;
  }
}

.floating-button.active {
  /* transform被移到内联样式中 */
  background: linear-gradient(135deg, rgba(30, 100, 200, 0.7) 0%, rgba(40, 120, 220, 0.8) 50%, rgba(30, 100, 200, 0.7) 100%);
  box-shadow: 
    0 5rpx 15rpx rgba(0, 0, 0, 0.25),
    inset 2rpx 2rpx 10rpx rgba(255, 255, 255, 0.6),
    inset -2rpx -2rpx 10rpx rgba(0, 0, 40, 0.35);
}

.floating-button.dragging {
  box-shadow: 
    0 8rpx 20rpx rgba(0, 0, 0, 0.3),
    inset 3rpx 3rpx 15rpx rgba(255, 255, 255, 0.5),
    inset -3rpx -3rpx 15rpx rgba(0, 0, 40, 0.3);
  transform: scale(1.12);
  opacity: 0.9;
}

.button-icon {
  color: white;
  font-size: 40rpx;
  font-weight: bold;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.25);
  position: relative;
  width: 45%;
  height: 50%;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  align-items: center;
  z-index: 2; /* 确保图标在流光效果之上 */
}

/* 自定义三条线图标 */
.button-icon::before,
.button-icon::after,
.button-icon-middle {
  content: "";
  display: block;
  width: 100%;
  height: 3rpx;
  background-color: white;
  border-radius: 2rpx;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2); /* 给线条添加细微阴影 */
  transition: transform 0.3s, width 0.3s;
}

/* 激活状态下的图标变换，形成X形 */
.active .button-icon::before {
  transform: translateY(6rpx) rotate(45deg);
}

.active .button-icon::after {
  transform: translateY(-6rpx) rotate(-45deg);
}

.active .button-icon-middle {
  opacity: 0;
  transform: scale(0);
}

/* 轮播图面板 */
.carousel-panel {
  position: fixed;
  top: 30rpx; /* Keep 30rpx from the top edge */
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
  height: auto; /* Let height be determined by top and bottom positions */
  max-height: 90vh; /* 增加最大高度，允许占据更多视口空间 */
  background-color: #1a3a5a;
  border-radius: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.3);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s, transform 0.3s;
  bottom: 105rpx; /* 修改底部位置，保持与悬浮按钮之间10rpx的距离 */
  margin: 0; /* Reset all margins */
}

.carousel-panel.visible {
  opacity: 1;
  visibility: visible;
}

.carousel-panel.hidden {
  opacity: 0;
  visibility: hidden;
}

/* 公告页的特殊样式，允许内容区域更大 */
.announcement-page .scrollable-content {
