[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
	ignorecase = true
	precomposeunicode = true
[remote "origin"]
	url = https://github.com/zzlovethis/cursorBrain0427.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "core"]
	remote = origin
	merge = refs/heads/core
[gui]
	wmstate = normal
	geometry = 1920x1030+0+0 237 247
[gitflow "branch"]
	master = main
	develop = develop
[gitflow "prefix"]
	feature = feature/
	release = release/
	hotfix = hotfix/
	support = support/
	versiontag = 
[github]
	user = zzlovethis
[credential]
	helper = cache 